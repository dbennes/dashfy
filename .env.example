# =========================================================
# SHELL BI - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# =========================================================

# Django
DJANGO_SECRET_KEY=troque-esta-chave-em-producao-use-uma-chave-longa-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br

# Production cockpit mode
# True = normal cockpit screens read only this app's SQLite snapshots.
# Admin-only update buttons may still query source systems to refresh local snapshots.
DASHFY_SQLITE_ONLY=True
# False = Datafy/Taskfy/Schedule/Eclic legacy pages are blocked/redirected to the cockpit.
DASHFY_ENABLE_LEGACY_MODULES=False

# SQLite - banco proprio do DASHFY (usuarios, permissoes, imports e snapshots)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# SQLite - banco de negocio local. Mantenha igual ao default para deploy standalone.
BUSINESS_DB_ENGINE=django.db.backends.sqlite3
BUSINESS_DB_NAME=db.sqlite3

# PostgreSQL - banco principal do BI (modo legado/desenvolvimento)
# Normal screens do not use this when DASHFY_SQLITE_ONLY=True.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=shellbi
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL - banco de dados de negocio (modo legado/desenvolvimento)
# Pode ser o mesmo do DB principal; se for outro, preencha aqui
BUSINESS_DB_NAME=datafy
BUSINESS_DB_USER=postgres
BUSINESS_DB_PASSWORD=postgres
BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=5432

# PostgreSQL - DATAFY operacional, usado apenas no update manual de admin/legado.
DATAFY_DB_NAME=DATAFY
DATAFY_DB_USER=postgres
DATAFY_DB_PASSWORD=postgres
DATAFY_DB_HOST=localhost
DATAFY_DB_PORT=5432
DATAFY_BASE_URL=http://127.0.0.1:8000

# ECLIC API
ECLIC_API_BASE_URL=https://api.eclic.example.com
ECLIC_API_KEY=
ECLIC_API_USER=
ECLIC_API_PASSWORD=
ECLIC_API_TIMEOUT=30

# P6 export CSV usado no cockpit de cronograma
P6_EXPORT_PATH=C:\Users\seu.usuario\Downloads\schedule_template_br.csv
P6_CURVES_PATH=C:\Users\seu.usuario\Downloads\Annex III -CURVES BN-EPC 1-WEEKLY-NW-W102.xlsx

# Redis (cache + celery)
REDIS_URL=redis://localhost:6379/0

# Email (recuperacao de senha, alertas)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Shell BI <no-reply@shellbi.local>

# Branding
APP_NAME=Shell BI
APP_BRAND_PRIMARY=#FBCE07
APP_BRAND_SECONDARY=#DD1D21
APP_BRAND_DARK=#404040
